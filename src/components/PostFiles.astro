---
import { archiveName, postUrl, type PostFile } from '../lib/post-files'
import { SITE_REPOSITORY } from '../site'
interface Props {
  id: string
  files: PostFile[]
}
const { id, files } = Astro.props
const size = (bytes: number) =>
  bytes < 1024
    ? `${bytes} B`
    : bytes < 1048576
      ? `${(bytes / 1024).toFixed(1)} KB`
      : `${(bytes / 1048576).toFixed(1)} MB`
---

<section class='post-files' aria-labelledby='post-files-heading'>
  <h2 id='post-files-heading'>Files &amp; source</h2>
  <p>
    Original files, including the article source. <a
      href={`${postUrl(id)}/${archiveName(id)}`}
      download={archiveName(id)}>Download all files (ZIP)</a
    > or <a href={`${SITE_REPOSITORY}/tree/main/content/posts/${id}`}
      >browse the source and history</a
    >.
  </p>
  <details>
    <summary>{files.length} files</summary>
    <ul>
      {
        files.map((file) => (
          <li>
            <a href={file.url} download={file.name.split('/').at(-1)}>
              {file.label}
            </a>{' '}
            <span class='file-size'>({size(file.size)})</span>
            {file.description && <p>{file.description}</p>}
          </li>
        ))
      }
    </ul>
  </details>
</section>
<style>
  .post-files {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-text-muted, #888);
  }
  .post-files li {
    overflow-wrap: anywhere;
    margin-block: 0.5rem;
  }
  .file-size {
    opacity: 0.75;
    white-space: nowrap;
  }
  summary {
    cursor: pointer;
  }
</style>
