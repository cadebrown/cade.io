---
// JSON-LD structured data for blog posts. Helps search engines build rich results.
// Schema reference: https://schema.org/BlogPosting

import type { ImageMetadata } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { SITE_TITLE, SITE_CANON } from '@site'
import { authorUrl, canonicalPath } from '../lib/urls'
import { imageUrl } from '../lib/metadata'

type Props = {
  title: string
  blurb: string
  dated?: Date
  updated?: Date
  image?: ImageMetadata | string
  authors?: CollectionEntry<'authors'>[]
}

const { title, blurb, dated, updated, image, authors } = Astro.props

const url = new URL(canonicalPath(Astro.url.pathname), Astro.site).toString()

const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: blurb,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: SITE_CANON,
  },
}

if (dated) {
  data.datePublished = dated.toISOString()
  data.dateModified = (updated ?? dated).toISOString()
}
if (image) data.image = imageUrl(image, Astro.site!).href
if (authors && authors.length > 0) {
  data.author = authors.map((a) => ({
    '@type': 'Person',
    name: a.data.name,
    url: new URL(authorUrl(a.id), Astro.site).href,
  }))
}
---

<script
  is:inline
  type='application/ld+json'
  set:html={JSON.stringify(data).replace(/</g, '\\u003c')}
/>
