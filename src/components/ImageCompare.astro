---
import type { ImageMetadata } from 'astro'
import { Image as AstroImage } from 'astro:assets'

type Props = {
  before: ImageMetadata
  after: ImageMetadata
  beforeAlt: string
  afterAlt: string
  beforeLabel?: string
  afterLabel?: string
  caption?: string
  initialPercent?: number
}

const {
  before,
  after,
  beforeAlt,
  afterAlt,
  beforeLabel = 'Before',
  afterLabel = 'After',
  caption,
  initialPercent = 50,
} = Astro.props

if (!beforeAlt.trim() || !afterAlt.trim()) {
  throw new Error('ImageCompare requires descriptive beforeAlt and afterAlt text.')
}

if (before.width * after.height !== after.width * before.height) {
  throw new Error(
    `ImageCompare requires before and after images with the same aspect ratio (received ${before.width}×${before.height} and ${after.width}×${after.height}).`
  )
}

const parsedInitialPercent = Number(initialPercent)
if (!Number.isFinite(parsedInitialPercent)) {
  throw new Error('ImageCompare initialPercent must be a finite number.')
}

const percent = Math.min(100, Math.max(0, parsedInitialPercent))
const aspectRatio = `${before.width} / ${before.height}`
const sizes = '(max-width: 800px) calc(100vw - 2rem), 800px'
---

<figure class='image-compare-figure'>
  <image-compare class='image-compare' data-initial-percent={percent}>
    <div class='image-compare__stage' style={`aspect-ratio: ${aspectRatio}`} data-stage>
      <div class='image-compare__fallback' data-fallback>
        <section class='image-compare__fallback-image'>
          <AstroImage src={before} alt={beforeAlt} sizes={sizes} class='image-compare__image' />
          <p class='image-compare__label image-compare__label--before'>{beforeLabel}</p>
        </section>
        <section class='image-compare__fallback-image'>
          <AstroImage src={after} alt={afterAlt} sizes={sizes} class='image-compare__image' />
          <p class='image-compare__label image-compare__label--after'>{afterLabel}</p>
        </section>
      </div>

      <div
        class='image-compare__interactive'
        aria-hidden='true'
        aria-label={`${beforeLabel}: ${beforeAlt}. ${afterLabel}: ${afterAlt}.`}
        role='img'
        data-interactive
      >
        <AstroImage
          src={after}
          alt=''
          aria-hidden='true'
          sizes={sizes}
          class='image-compare__image'
        />
        <div class='image-compare__before-clip' data-before-clip>
          <AstroImage
            src={before}
            alt=''
            aria-hidden='true'
            sizes={sizes}
            class='image-compare__image'
          />
        </div>
        <span class='image-compare__label image-compare__label--before'>{beforeLabel}</span>
        <span class='image-compare__label image-compare__label--after'>{afterLabel}</span>
        <span class='image-compare__divider' aria-hidden='true'></span>
      </div>
    </div>

    <div class='image-compare__controls'>
      <p class='image-compare__fallback-copy' data-fallback-copy>Both complete images are shown.</p>
      <div class='image-compare__slider-controls' hidden data-controls>
        <span>{beforeLabel}</span>
        <input
          class='image-compare__range'
          type='range'
          min='0'
          max='100'
          step='1'
          value={percent}
          aria-label={`Reveal ${beforeLabel} and ${afterLabel} images`}
          disabled
          data-range
        />
        <output data-output>{percent}%</output>
        <span>{afterLabel}</span>
      </div>
    </div>
  </image-compare>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  class ImageCompareElement extends HTMLElement {
    private cleanup?: () => void

    connectedCallback() {
      if (this.cleanup) return

      const stage = this.querySelector<HTMLElement>('[data-stage]')
      const range = this.querySelector<HTMLInputElement>('[data-range]')
      const controls = this.querySelector<HTMLElement>('[data-controls]')
      const output = this.querySelector<HTMLOutputElement>('[data-output]')
      const interactive = this.querySelector<HTMLElement>('[data-interactive]')
      const fallbackCopy = this.querySelector<HTMLElement>('[data-fallback-copy]')

      if (!stage || !range || !controls || !output || !interactive || !fallbackCopy) return

      const update = () => {
        const value = Math.min(100, Math.max(0, Number(range.value)))
        range.value = String(value)
        stage.style.setProperty('--image-compare-percent', `${value}%`)
        output.value = `${value}%`
        output.textContent = `${value}%`
      }

      const updateFromPointer = (event: PointerEvent) => {
        const bounds = stage.getBoundingClientRect()
        const value = Math.round(((event.clientX - bounds.left) / bounds.width) * 100)
        range.value = String(Math.min(100, Math.max(0, value)))
        update()
      }

      let activePointerId: number | undefined
      const startPointer = (event: PointerEvent) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return

        activePointerId = event.pointerId
        stage.setPointerCapture(event.pointerId)
        updateFromPointer(event)
        event.preventDefault()
      }
      const movePointer = (event: PointerEvent) => {
        if (activePointerId === event.pointerId) updateFromPointer(event)
      }
      const endPointer = (event: PointerEvent) => {
        if (activePointerId !== event.pointerId) return
        if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId)
        activePointerId = undefined
      }

      range.disabled = false
      controls.hidden = false
      fallbackCopy.hidden = true
      interactive.removeAttribute('aria-hidden')
      this.dataset.enhanced = 'true'
      update()
      range.addEventListener('input', update)
      stage.addEventListener('pointerdown', startPointer)
      stage.addEventListener('pointermove', movePointer)
      stage.addEventListener('pointerup', endPointer)
      stage.addEventListener('pointercancel', endPointer)

      this.cleanup = () => {
        range.removeEventListener('input', update)
        stage.removeEventListener('pointerdown', startPointer)
        stage.removeEventListener('pointermove', movePointer)
        stage.removeEventListener('pointerup', endPointer)
        stage.removeEventListener('pointercancel', endPointer)
        if (activePointerId !== undefined && stage.hasPointerCapture(activePointerId)) {
          stage.releasePointerCapture(activePointerId)
        }
        activePointerId = undefined
        range.disabled = true
        controls.hidden = true
        fallbackCopy.hidden = false
        interactive.setAttribute('aria-hidden', 'true')
        this.dataset.enhanced = ''
      }
    }

    disconnectedCallback() {
      this.cleanup?.()
      this.cleanup = undefined
    }
  }

  if (!customElements.get('image-compare')) {
    customElements.define('image-compare', ImageCompareElement)
  }
</script>

<style>
  .image-compare-figure {
    width: 100%;
    max-width: 800px;
    margin: 1rem 0;
  }

  .image-compare {
    display: block;
    width: 100%;
    color: var(--wow-text);
    font-family: var(--wow-font-text, monospace);
  }

  .image-compare__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--wow-border);
  }

  .image-compare__fallback-image {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--wow-back-alt);
  }

  :global(img.image-compare__image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-compare__fallback-image :global(img.image-compare__image),
  .image-compare__stage > :global(img.image-compare__image),
  .image-compare__before-clip :global(img.image-compare__image) {
    position: absolute;
    inset: 0;
  }

  .image-compare__fallback-image :global(img.image-compare__image) {
    object-fit: contain;
  }

  .image-compare__interactive {
    position: absolute;
    inset: 0;
  }

  .image-compare__interactive,
  .image-compare[data-enhanced='true'] .image-compare__fallback {
    visibility: hidden;
  }

  .image-compare[data-enhanced='true'] .image-compare__interactive {
    visibility: visible;
  }

  .image-compare__stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--wow-border);
    background: var(--wow-back-alt);
    touch-action: pan-y;
  }

  .image-compare[data-enhanced='true'] .image-compare__stage {
    cursor: ew-resize;
  }

  .image-compare__before-clip {
    position: absolute;
    inset: 0;
  }

  .image-compare__before-clip {
    clip-path: inset(0 calc(100% - var(--image-compare-percent, 50%)) 0 0);
  }

  .image-compare__label {
    position: absolute;
    top: 0.5rem;
    z-index: 1;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--wow-border);
    background: var(--wow-back-ult);
    color: var(--wow-text);
    font-family: var(--wow-font-mono, monospace);
    font-size: 0.8rem;
  }

  .image-compare__label--before {
    left: 0.5rem;
  }

  .image-compare__label--after {
    right: 0.5rem;
  }

  .image-compare__divider {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: var(--image-compare-percent, 50%);
    width: 2px;
    transform: translateX(-1px);
    background: var(--wow-link);
    pointer-events: none;
  }

  .image-compare__divider::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--wow-border);
    border-radius: 999px;
    background: var(--wow-back-ult);
    content: '↔';
    color: var(--wow-text);
    font-family: var(--wow-font-mono, monospace);
    font-size: 1rem;
    line-height: 1.45rem;
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .image-compare__controls {
    display: grid;
    min-height: 3.5rem;
    padding-top: 0.4rem;
    align-items: center;
    font-family: var(--wow-font-mono, monospace);
    font-size: 0.85rem;
  }

  .image-compare__fallback-copy {
    margin: 0;
  }

  .image-compare__slider-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
  }

  .image-compare__slider-controls[hidden] {
    display: none;
  }

  .image-compare__slider-controls span:first-child {
    grid-column: 1;
    grid-row: 1;
  }

  .image-compare__slider-controls output {
    grid-column: 2;
    grid-row: 1;
  }

  .image-compare__slider-controls span:last-child {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }

  .image-compare__range {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    accent-color: var(--wow-link);
    cursor: ew-resize;
  }

  .image-compare__range:focus-visible {
    outline: 2px solid var(--wow-link);
    outline-offset: 2px;
  }

  .image-compare__controls output {
    font-variant-numeric: tabular-nums;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
</style>
