---
import type { ImageMetadata } from 'astro'
import { Image as AstroImage } from 'astro:assets'

type Props = {
  src: ImageMetadata | string
  alt?: string
  style?: string
  class?: string
  sizes?: string
  width?: number
  height?: number
  loading?: 'lazy' | 'eager'
  priority?: boolean
  layout?: 'constrained' | 'fixed' | 'full-width' | 'none'
  fetchpriority?: 'high' | 'low' | 'auto'
  fit?: 'cover' | 'contain' | 'fill'
  quality?: number
}

const {
  src,
  alt = '',
  style,
  class: className,
  sizes = '(max-width: 800px) calc(100vw - 2rem), 800px',
  width,
  height,
  loading,
  priority = false,
  layout = 'constrained',
  fetchpriority,
  fit = 'cover',
  quality = 80,
} = Astro.props
---

{
  typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      style={style}
      class={className}
      width={width}
      height={height}
      loading={loading ?? (priority ? 'eager' : 'lazy')}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={fetchpriority ?? (priority ? 'high' : undefined)}
    />
  ) : (
    <AstroImage
      src={src}
      alt={alt}
      style={style}
      class={className}
      width={width}
      height={height}
      layout={layout}
      sizes={sizes}
      loading={loading}
      priority={priority}
      fetchpriority={fetchpriority}
      fit={fit}
      quality={quality}
    />
  )
}
