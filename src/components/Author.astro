---
import { getEntry, type CollectionEntry } from 'astro:content'
import { authorUrl } from '../lib/urls'

type Props = {
  author: CollectionEntry<'authors'> | { collection: 'authors'; id: string } | string
}

const { author: reference } = Astro.props
const author =
  typeof reference !== 'string' && 'data' in reference
    ? reference
    : await getEntry('authors', typeof reference === 'string' ? reference : reference.id)
if (!author)
  throw new Error(`Unknown author: ${typeof reference === 'string' ? reference : reference.id}`)
const href = authorUrl(author.id)
---

<a class='author-name' href={href}>{author.data.name}</a>

<style>
  .author-name {
    font-weight: bold;
    color: inherit;
  }
</style>
