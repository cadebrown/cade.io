---
import Icon from './Icon.astro'
import type { AuthorReference } from '../layouts/types'
import type { ImageMetadata } from 'astro'
import Image from './Image.astro'
import Dated from './Dated.astro'
import Authors from './Authors.astro'

type Props = {
  href: string
  image: ImageMetadata | string
  title: string
  blurb: string
  dated: Date
  authors: AuthorReference[]
}

const { href, image, title, blurb, dated, authors } = Astro.props
---

<li class='slab'>
  <slot name='image'>
    <a href={href} data-astro-prefetch class='slab-image'>
      <Image
        class='slab-image'
        src={image}
        alt={title}
        sizes='(max-width: 800px) calc(100vw - 2rem), 300px'
      />
    </a>
  </slot>

  <section class='slab-texts'>
    <slot name='title'>
      <span class='slab-title'>
        <a href={href} data-astro-prefetch>{title}</a>
      </span>
    </slot>

    <slot name='subtitle'>
      <span class='slab-subtitle'>
        on <Dated dated={dated} /> by <Authors authors={authors} />
      </span>
    </slot>

    <slot name='blurb'>
      <span class='slab-blurb'>
        {blurb}
      </span>
    </slot>

    <slot name='links'>
      <span class='slab-links'>
        <a href={href} data-astro-prefetch>View More <Icon name='uiux/arrow-right' /> </a>
      </span>
    </slot>
  </section>
</li>

<style>
  .slab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1em;
    align-items: start;
    width: 100%;
    margin: 0;
    padding: 1em 0;
    border-top: 1px solid var(--wow-border);
  }

  .slab img.slab-image {
    display: block;
    aspect-ratio: 3 / 2;
    height: auto;
    width: 100%;
    object-fit: cover;
    border-radius: 0.5em;
    border: 1px solid var(--wow-border);
    margin: 0;
  }

  .slab-texts {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.25em;
  }

  .slab-title {
    font-size: 1.4em;
    line-height: 1.2;
  }

  .slab-title a {
    color: inherit;
    font-weight: bold;
  }

  .slab-blurb {
    margin: 0.5em 0;
  }

  .slab-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .slab-links a {
    font-weight: bold;
    color: inherit;
    padding: 0.25em 0.5em;
    border-radius: 0.5em;
    border: 1px solid var(--wow-border);
    background: var(--wow-back-alt);
  }

  @media (max-width: 800px) {
    .slab {
      grid-template-columns: minmax(0, 1fr);
      text-align: center;
    }

    .slab-title {
      font-size: 1.3em;
    }

    .slab-links {
      justify-content: center;
    }
  }
</style>
