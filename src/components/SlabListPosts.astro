---
// SlabListPosts.astro - specialized SlabList for posts

import type { CollectionEntry } from 'astro:content'
import { postUrl } from '../lib/content'
import Slab from './Slab.astro'
import SlabList from './SlabList.astro'

type Props = {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<SlabList>
  {
    posts.map(({ id, data: { dated, title, blurb, image, authors } }) => (
      <Slab
        href={postUrl(id)}
        image={image}
        title={title}
        blurb={blurb}
        dated={dated}
        authors={authors}
      />
    ))
  }
</SlabList>
