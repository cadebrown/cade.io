---
import type { ImageMetadata } from 'astro'
import Image from './Image.astro'

type Props = {
  href: string
  image: ImageMetadata | string
  title: string
  blurb: string
}

const { href, image, title, blurb } = Astro.props
---

<li class='card'>
  <slot name='image'>
    <Image
      class='card-image'
      src={image}
      alt={title}
      sizes='(max-width: 600px) calc(100vw - 2rem), 384px'
    />
  </slot>
  <slot name='title'>
    <span class='card-title'>
      <a href={href}>{title}</a>
    </span>
  </slot>

  <slot name='subtitle' />

  <span class='card-blurb'>
    <slot name='blurb'>
      {blurb}
    </slot>
  </span>
  <span class='card-links'>
    <slot name='links'>
      <a href={href}>View More</a>
    </slot>
  </span>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 24em;
    min-width: 0;
    border: 1px solid var(--wow-border);
    border-radius: 0.5em;
  }

  .card img.card-image {
    display: block;
    height: auto;
    width: 100%;
    border-radius: 0.5em 0.5em 0 0;
    border-bottom: 1px solid var(--wow-border);
    margin-bottom: 0.5em;
  }

  .card-title {
    font-size: 1.4em;
    font-weight: bold;
    margin: 0 0.5em;
  }

  .card-title a {
    color: inherit;
  }

  .card-blurb {
    flex-grow: 1;
    width: 100%;
    padding: 0.75em;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5em;
    padding: 0.25em;
    width: 100%;
    margin-top: auto;
    border-top: 1px solid var(--wow-border);
  }

  .card-links a {
    display: block;
    font-weight: bold;
    padding: 0.5em 1em;
    border-radius: 0.5em;
    font-size: 1.1em;
  }
</style>
