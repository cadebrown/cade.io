---
import type { ImageMetadata } from 'astro'
import Image from './Image.astro'

type GalleryImage = {
  src: string | ImageMetadata
  alt: string
  caption?: string
  original?: string
}

type Props = {
  images: (string | ImageMetadata | GalleryImage)[]
  alt?: string
  originals?: string[]
  layout?: 'grid' | 'rows'
}

const { images, alt = 'Gallery image', originals = [], layout = 'grid' } = Astro.props
const entries = images.map((image, index): GalleryImage => {
  if (typeof image === 'object' && 'alt' in image) return image
  return { src: image, alt: `${alt} (${index + 1})`, original: originals[index] }
})
if (layout === 'rows' && entries.some(({ src }) => typeof src === 'string')) {
  throw new Error('Gallery rows require imported image metadata to preserve proportional geometry.')
}
---

<ol class:list={['gallery-list', { 'gallery-rows': layout === 'rows' }]}>
  {
    entries.map(({ src, alt, caption, original }) => (
      <li
        class='gallery-item'
        style={
          layout === 'rows'
            ? `--image-ratio: ${typeof src === 'string' ? 1 : src.width / src.height}`
            : undefined
        }
      >
        <figure>
          {original ? (
            <a href={original} aria-label={`Open original: ${alt}`}>
              <Image
                src={src}
                alt={alt}
                sizes={
                  layout === 'rows'
                    ? '(max-width: 600px) calc(100vw - 2rem), 60vw'
                    : '(max-width: 600px) calc(100vw - 2rem), (max-width: 1000px) 45vw, 380px'
                }
              />
            </a>
          ) : (
            <Image
              src={src}
              alt={alt}
              sizes={
                layout === 'rows'
                  ? '(max-width: 600px) calc(100vw - 2rem), 60vw'
                  : '(max-width: 600px) calc(100vw - 2rem), (max-width: 1000px) 45vw, 380px'
              }
            />
          )}
          {(caption || original) && (
            <figcaption>
              {caption && <span>{caption}</span>}
              {original && (
                <a href={original} download>
                  Download original
                </a>
              )}
            </figcaption>
          )}
        </figure>
      </li>
    ))
  }
</ol>

<style>
  .gallery-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .gallery-item,
  .gallery-item figure {
    min-width: 0;
    margin: 0;
    padding: 0;
  }
  .gallery-item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 0.5rem;
    border: 1px solid var(--wow-border);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: 0.85em;
  }
  .gallery-rows {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
  }
  .gallery-rows .gallery-item {
    flex: var(--image-ratio) 1 calc(var(--image-ratio) * 10rem);
    min-width: min(100%, 8rem);
  }
  .gallery-rows :global(img) {
    max-height: none;
  }
  @media (max-width: 600px) {
    .gallery-rows .gallery-item {
      flex: 1 1 100%;
    }
  }
</style>
