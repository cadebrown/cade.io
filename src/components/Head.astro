---
// import CSS styles
import '@styles/wow.css'
import '@styles/cadeio.css'
import '@styles/navigation.css'
import '@styles/tables.css'

import { SITE_NAME, SITE_TITLE } from '@site'
import type { ImageMetadata } from 'astro'
import { canonicalPath } from '../lib/urls'
import { imageUrl } from '../lib/metadata'
import { THEMES, DEFAULT_THEME } from '../lib/theme'

type Props = {
  title: string
  blurb: string
  image?: ImageMetadata | string
  kind?: 'website' | 'article'
}

// generate canonical URL for this page
const canon = new URL(canonicalPath(Astro.url.pathname), Astro.site)

const { title, blurb, image, kind = 'website' } = Astro.props

// add in the site's title to the page's title
const title_full = `${title} | ${SITE_NAME}`

const image_url = imageUrl(image, Astro.site!)
---

<script is:inline data-themes={JSON.stringify(THEMES)} data-default-theme={DEFAULT_THEME}>
  // Run before paint; a deferred module would briefly show the wrong theme.
  {
    const script = document.currentScript
    const themes = JSON.parse(script?.getAttribute('data-themes') || '[]')
    let theme = script?.getAttribute('data-default-theme')
    try {
      const saved = localStorage.getItem('theme')
      if (themes.includes(saved)) theme = saved
    } catch {
      // Storage can be blocked; the site still renders with its default theme.
    }
    if (theme) document.documentElement.dataset.theme = theme
  }
</script>

<!-- Site Metadata -->
<meta charset='utf-8' />
<meta name='viewport' content='width=device-width, initial-scale=1' />
<meta name='generator' content={Astro.generator} />
<link rel='sitemap' href='/sitemap-index.xml' />
<link
  rel='alternate'
  type='application/json'
  href='/content-index.json'
  title='Published article index'
/>
<link
  rel='alternate'
  type='application/rss+xml'
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<!-- Site Favicon (autogenerated) -->
<link rel='icon' type='image/png' href='/favicon-96x96.png' sizes='96x96' />
<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
<link rel='shortcut icon' href='/favicon.ico' />
<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
<meta name='apple-mobile-web-app-title' content='cade.io' />
<link rel='manifest' href='/site.webmanifest' />

<!-- Page Metadata -->
<title>{title_full}</title>
<meta name='title' content={title_full} />
<meta name='description' content={blurb} />
<link rel='canonical' href={canon} />

<!-- Page Metadata: Open Graph / Facebook-->
<meta property='og:type' content={kind} />
<meta property='og:url' content={canon} />
<meta property='og:title' content={title_full} />
<meta property='og:description' content={blurb} />
<meta property='og:image' content={image_url} />

<!-- Page Metadata: Twitter -->
<meta property='twitter:card' content='summary_large_image' />
<meta property='twitter:url' content={canon} />
<meta property='twitter:title' content={title_full} />
<meta property='twitter:description' content={blurb} />
<meta property='twitter:image' content={image_url} />

<script>
  import { registerSiteTools } from '../lib/site-tools'
  registerSiteTools()
</script>
