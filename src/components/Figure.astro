---
import type { ImageMetadata } from 'astro'
import Image from './Image.astro'

type Props = {
  src: ImageMetadata | string
  alt?: string
  caption?: string
  style?: string
  class?: string
  href?: string
  original?: string
  imgStyle?: string
  imgClass?: string
  sizes?: string
  priority?: boolean
  width?: number
  height?: number
  layout?: 'constrained' | 'fixed' | 'full-width' | 'none'
  fit?: 'cover' | 'contain' | 'fill'
}

const {
  src,
  alt,
  caption = alt,
  style,
  class: className,
  href,
  original,
  imgStyle,
  imgClass,
  sizes,
  priority,
  width,
  height,
  layout,
  fit,
  ...rest
} = Astro.props
---

<figure class:list={[className]} style={style} {...rest}>
  <slot />
  {
    href ? (
      <a href={href}>
        <Image
          src={src}
          alt={alt}
          style={imgStyle}
          class={imgClass}
          {sizes}
          {priority}
          {width}
          {height}
          {layout}
          {fit}
        />
      </a>
    ) : (
      <Image
        src={src}
        alt={alt}
        style={imgStyle}
        class={imgClass}
        {sizes}
        {priority}
        {width}
        {height}
        {layout}
        {fit}
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
  {
    original && (
      <a href={original} download>
        Download original
      </a>
    )
  }
</figure>
