---
import type { ImageMetadata } from 'astro'
import Image from './Image.astro'

type Props = {
  src: ImageMetadata | string
  alt?: string
  caption?: string
  style?: string
  class?: string
  href?: string
  original?: string
  imgStyle?: string
  imgClass?: string
}

const {
  src,
  alt,
  caption = alt,
  style,
  class: className,
  href,
  original,
  imgStyle,
  imgClass,
  ...rest
} = Astro.props
---

<figure class:list={[className]} style={style} {...rest}>
  <slot />
  {
    href ? (
      <a href={href}>
        <Image src={src} alt={alt} style={imgStyle} class={imgClass} />
      </a>
    ) : (
      <Image src={src} alt={alt} style={imgStyle} class={imgClass} />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
  {
    original && (
      <a href={original} download>
        Download original
      </a>
    )
  }
</figure>
