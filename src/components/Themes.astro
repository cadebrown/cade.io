---
import { DEFAULT_THEME, THEMES } from '../lib/theme'
---

<div role='group' aria-label='Color theme'>
  <span>themes: [</span>
  {
    THEMES.map((theme) => (
      <button
        type='button'
        title={`set theme: '${theme}'`}
        aria-label={`set theme: '${theme}'`}
        aria-pressed={theme === DEFAULT_THEME}
        class={`themes themes-${theme}`}
        data-theme={theme}
      />
    ))
  }
  <span>]</span>
</div>

<style>
  div {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .themes {
    width: 2.5em;
    height: 2.5em;
    border-radius: 0.5em;
    cursor: pointer;
  }

  .themes[aria-pressed='true'] {
    outline: 2px solid var(--wow-text);
    outline-offset: 3px;
  }

  .themes-blackboard {
    background-image: linear-gradient(135deg, #999 49%, #111 51%);
  }
  .themes-whiteboard {
    background-image: linear-gradient(135deg, #eee 49%, #999 51%);
  }
  .themes-debugboard {
    background-image: linear-gradient(135deg, #2d2 49%, #111 51%);
  }
</style>

<script>
  import { initializeThemeControls } from '../lib/theme'
  initializeThemeControls()
</script>
