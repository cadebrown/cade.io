---
import Base from '@layouts/Base.astro'
import Image from '@components/Image.astro'
import { type CollectionEntry, getCollection } from 'astro:content'
import Socials from '@components/Socials.astro'
import CardListPosts from '@components/CardListPosts.astro'
import { getPublishedPosts } from '../../lib/content'

// define which paths are valid for this page
export async function getStaticPaths() {
  const authors = await getCollection('authors')
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author: author },
  }))
}

type Props = {
  author: CollectionEntry<'authors'>
}

const { author: author_ } = Astro.props
const { name, blurb, image, socials } = author_.data

// get posts by this author, sorted by most recent
const posts = (await getPublishedPosts({ includeDrafts: import.meta.env.DEV })).filter((post) =>
  post.data.authors.some((author) => author.id === author_.id)
)

const title = `${name}`
---

<Base title={title} blurb={blurb} image={image}>
  <center class='author-top' slot='header-after'>
    {image && <Image class='author-top-image' src={image} alt={title} />}
    <h1 class='author-top-title'>{title}</h1>
    <span class='author-top-socials'>
      <Socials socials={socials} />
    </span>
    {blurb && <p class='author-top-blurb'>{blurb}</p>}
  </center>

  <center>
    <h2>View Their Posts</h2>
    <CardListPosts posts={posts} />
  </center>
</Base>

<style>
  center.author-top {
    /* width: 80%; */
    margin: 1em auto;
  }

  h1.author-top-title {
    font-size: 2.5em;
  }

  span.author-top-socials {
    font-size: 1.2em;
  }

  p.author-top-blurb {
    font-size: 1.4em;
  }
  img.author-top-image {
    display: block;
    /* float: left; */
    max-height: 50vh;
    border-radius: 1em;
    /* border-radius: 0.5em 0 0 0.5em; */
    /* border: 1px solid black; */
  }

  center.author-top img.asdf {
    /* width: 100%; */
    max-height: 40vh;
    border-radius: 0.5em;
    /* object-fit: cover; */
  }
</style>
