---
import { getCollection } from 'astro:content'

import Base from '@layouts/Base.astro'

import CardListAuthors from '@components/CardListAuthors.astro'

// fetch all the authors
// TODO: sort by something?
const authors = await getCollection('authors')

const title = 'All authors'
const blurb = 'A list of all the authors on the site.'
---

<Base title={title} blurb={blurb}>
  <center>
    <CardListAuthors authors={authors} />
  </center>
</Base>
