{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "artifacts"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@public/*": [
        "./public/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@site": [
        "./src/site.ts"
      ],
      "@format": [
        "./src/format.ts"
      ],
      "@themes": [
        "./src/themes.ts"
      ],
      "@katex": [
        "./src/katex.ts"
      ]
    }
  }
}
