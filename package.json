{
  "name": "cade.io",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check",
    "deploy:pages": "wrangler pages deploy dist",
    "test:browser": "playwright test",
    "validate": "npm run format:check && npm run check && npm run build && npm test && npm run test:browser",
    "format:check": "prettier --check \"src/**/*.{astro,ts}\" \"tests/**/*.ts\" \"content/**/*.{astro,ts}\" \"scripts/*.mjs\" astro.config.ts playwright.config.ts ec.config.mjs",
    "validate:ci": "playwright install --with-deps chromium && npm run validate",
    "inventory:urls": "node scripts/inventory-urls.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@mermaid-js/layout-elk": "^0.2.3",
    "apexcharts": "^7.1.0",
    "astro": "^7.3.1",
    "astro-expressive-code": "^0.44.2",
    "astro-mermaid": "^2.1.0",
    "expressive-code-color-chips": "^0.2.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "mermaid": "^11.17.2",
    "satteri": "^0.10.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@12.0.2"
}
